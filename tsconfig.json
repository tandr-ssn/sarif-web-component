{
	"compilerOptions": {
		"outDir": "dist", // './' prefix not necessary
		"rootDir": ".",
		"declaration": true,
		"sourceMap": true,
		"strict": false,
		"noImplicitAny": false,
		"noUncheckedSideEffectImports": false,
		"target": "ES6",
		"module": "Node20", // Preserve CommonJS initialization order for the circular viewer modules in the Webpack bundle.
		"moduleResolution": "Node16",
		"esModuleInterop": true,
		"jsx": "react",
		"skipLibCheck": true,
		"experimentalDecorators": true,
		"types": ["*"]
	},
	"exclude": [
		"dist", // Avoids error: Cannot write file '/dist/components/FilterBar.d.ts' because it would overwrite input file.
		"index.tsx", // For webpack-dev-server only. Prevent index.d.ts being generated to /dist.
	]
}
