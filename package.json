{
	"name": "@acah/sarif-web-component",
	"version": "0.6.0-29",
	"author": "Microsoft",
	"description": "SARIF Viewer",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/tandr-ssn/sarif-web-component"
	},
	"bugs": {
		"url": "https://github.com/tandr-ssn/sarif-web-component/issues"
	},
	"homepage": "https://tandr-ssn.github.io/sarif-web-component/",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"start": "tsc --noEmit && vite",
		"test": "jest",
		"test:e2e": "npm run build && playwright test",
		"test:watch": "jest --watchAll",
		"typecheck": "tsc --noEmit",
		"clean:npm": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
		"npm": "npm run clean:npm && tsc --project tsconfig.npm.json --emitDeclarationOnly && vite build --config ./vite.config.npm.js",
		"build": "tsc --noEmit && vite build --config ./vite.config.docs.js"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@playwright/test": "^1.62.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/jest": "30.0.0",
		"@types/node": "^24.13.3",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/sarif": "^2.1.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^5.0.4",
		"autobind-decorator": "^2.4.0",
		"babel-jest": "30.4.1",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"ts-jest": "29.4.12",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.2.1"
	},
	"dependencies": {
		"azure-devops-ui": "^2.277.0",
		"highlight.js": "^11.12.0",
		"mobx": "^7.0.0",
		"mobx-react": "^10.0.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"sass": "^1.80.6",
		"unified": "^11.0.5"
	},
	"peerDependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"files": [
		"dist/components",
		"dist/index.js",
		"dist/index.mjs",
		"schema/*.json"
	],
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/components/Viewer.d.ts",
	"exports": {
		".": {
			"types": "./dist/components/Viewer.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	}
}
